# Campus Foodly Environment Configuration
# Copy this file to .env.development and fill in your actual values
# NEVER commit actual credentials - always use placeholders in version control

# ============================================================================
# M-PESA PAYMENT (Daraja API)
# Get from: https://developer.safaricom.co.ke/
# Required: All three keys must be set (not PLACEHOLDER) for production
# ============================================================================
MPESA_CONSUMER_KEY=PLACEHOLDER_MPESA_CONSUMER_KEY
MPESA_CONSUMER_SECRET=PLACEHOLDER_MPESA_CONSUMER_SECRET
MPESA_SHORTCODE=174379
MPESA_PASSKEY=PLACEHOLDER_MPESA_PASSKEY
MPESA_SANDBOX_URL=https://sandbox.safaricom.co.ke
MPESA_LIVE_URL=https://api.safaricom.co.ke
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_URL=https://your-backend.com/mpesa/callback

# ============================================================================
# GOOGLE MAPS API
# Get from: https://console.cloud.google.com/apis/
# ============================================================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ============================================================================
# CLAUDE AI (Anthropic API)
# Get from: https://console.anthropic.com/
# Used for: Customer support chatbot, order issue resolution
# ============================================================================
CLAUDE_API_KEY=your_claude_api_key
CLAUDE_API_URL=https://api.anthropic.com/v1

# ============================================================================
# AFRICA'S TALKING (WhatsApp & SMS)
# Get from: https://africastalking.com/
# Used for: WhatsApp rider bot, vendor notifications, SMS alerts
# ============================================================================
AT_API_KEY=your_africas_talking_api_key
AT_USERNAME=your_africas_talking_username
AT_SENDER_ID=your_sender_id

# ============================================================================
# Firebase Configuration
# Auto-configured via GoogleService-Info.plist (iOS) and google-services.json (Android)
# See: lib/firebase_options.dart
# ============================================================================
FIREBASE_PROJECT_ID=foodly-99135
FIREBASE_STORAGE_BUCKET=foodly-99135.appspot.com

# ============================================================================
# Cloudinary Cloud Storage (Optional - for image hosting)
# Get credentials from: https://cloudinary.com/console/settings/api
# ============================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=campus-foodly/production

# ============================================================================
# External Callbacks & Webhooks
# ============================================================================
MPESA_CALLBACK_URL=https://your-backend.com/mpesa/callback
DARAJA_CALLBACK_URL=https://your-backend.com/daraja/callback
AT_WEBHOOK_URL=https://your-backend.com/webhooks/africas-talking

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_OFFLINE_MODE=true
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true
ENABLE_PAYMENT_DEBUG=false

# ============================================================================
# API Configuration
# ============================================================================
API_TIMEOUT_SECONDS=30
API_RETRY_ATTEMPTS=3
MPESA_POLLING_INTERVAL_SECONDS=3
MPESA_POLLING_MAX_ATTEMPTS=10

# ============================================================================
# Campus Configuration (For Testing)
# ============================================================================
DEFAULT_CAMPUS_ID=kca-university
DEFAULT_CAMPUS_NAME=KCA University
