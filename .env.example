# Campus Foodly Environment Configuration
# Copy this file to .env.development and fill in your actual values
# NEVER commit actual credentials - always use placeholders in version control

# Cloudinary Cloud Storage
# Get credentials from: https://cloudinary.com/console/settings/api
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=pro-grocery/production

# Firebase Configuration
# Auto-configured via GoogleService-Info.plist (iOS) and google-services.json (Android)
# See: lib/firebase_options.dart

# Payment Processor (Stripe example)
# Get from: https://dashboard.stripe.com/apikeys
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...

# API Endpoints (if using external services)
# API_BASE_URL=https://api.example.com
# API_TIMEOUT_SECONDS=30

# Feature Flags
# ENABLE_OFFLINE_MODE=true
# ENABLE_ANALYTICS=true
# ENABLE_CRASH_REPORTING=true
