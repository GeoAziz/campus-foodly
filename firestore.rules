rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==================== SECURITY FUNCTIONS ====================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isRestaurantOwner(restaurantId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
        get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == request.auth.uid;
    }

    function isDeliveryStaff() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'delivery';
    }

    function isOrderOwner(orderId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/orders/$(orderId)) &&
        get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid;
    }

    function isValidPaymentStatus(status) {
      return status in ['pending', 'processing', 'succeeded', 'failed'];
    }

    function isValidOrderStatus(status) {
      return status in ['pending', 'accepted', 'preparing', 'ready', 'picked_up', 'delivered', 'cancelled'];
    }
    
    // ==================== RATE LIMITING & VALIDATION ====================
    
    // Rate limit: max 10 order creates per user per day
    function checkOrderCreateRateLimit() {
      return isAuthenticated() &&
        firestore.query('orders')
          .where('userId', '==', request.auth.uid)
          .where('createdAt', '>=', now.toMillis() - (24 * 3600 * 1000))
          .count() < 10;
    }
    
    // Rate limit: max 5 payment creates per user per day
    function checkPaymentCreateRateLimit() {
      return isAuthenticated() &&
        firestore.query('payments')
          .where('userId', '==', request.auth.uid)
          .where('createdAt', '>=', now.toMillis() - (24 * 3600 * 1000))
          .count() < 5;
    }
    
    // Validate order structure and prevent common attacks
    function isValidOrderCreate() {
      return request.resource.data.keys().hasAll(['userId', 'restaurantId', 'items', 'status', 'createdAt', 'idempotencyKey']) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.items.size() <= 100 &&
        request.resource.data.totalPrice is number &&
        request.resource.data.totalPrice > 0 &&
        request.resource.data.totalPrice <= 10000 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.idempotencyKey is string &&
        request.resource.data.idempotencyKey.size() > 0;
    }
    
    // Check for duplicate orders using idempotency key
    function isDuplicateOrder() {
      return firestore.query('orders')
        .where('userId', '==', request.auth.uid)
        .where('idempotencyKey', '==', request.resource.data.idempotencyKey)
        .where('createdAt', '>=', now.toMillis() - (3600 * 1000))
        .count() > 0;
    }
    
    // Validate payment structure
    function isValidPaymentCreate() {
      return request.resource.data.keys().hasAll(['userId', 'orderId', 'amount', 'status', 'provider', 'createdAt']) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.amount <= 10000 &&
        request.resource.data.provider in ['stripe', 'paypal', 'card', 'mpesa', 'mpesa_mock'] &&
        isValidPaymentStatus(request.resource.data.status);
    }

    // Users Collection
    match /users/{userId} {
      // Users can read their own data; admins can read any user.
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);

      // Users create their own account on signup.
      allow create: if isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.role == 'user';

      // Users can update their own profile, but cannot change identity or role.
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.role == resource.data.role
      );

      // Prevent deletion.
      allow delete: if false;

      // User sub-collections
      match /addresses/{addressId} {
        allow read, create, update, delete: if isAuthenticated() && request.auth.uid == userId;
      }

      match /paymentMethods/{paymentId} {
        allow read, create, update, delete: if isAuthenticated() && request.auth.uid == userId;
      }

      match /settings/{settingId} {
        allow read, create, update, delete: if isAuthenticated() && request.auth.uid == userId;
      }

      match /fcmTokens/{tokenId} {
        allow read, create, update, delete: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Restaurants Collection
    match /restaurants/{restaurantId} {
      // Restaurant catalog is public in the app.
      allow read: if true;
      
      // Admins manage restaurant entries.
      allow create: if isAdmin();
      
      allow update: if isAdmin();
      
      // Only admins can delete.
      allow delete: if isAdmin();

      // Menu sub-collection
      match /menu/{menuItemId} {
        allow read: if true;
        
        allow create, update, delete: if isAdmin();
      }

      // Reviews sub-collection
      match /reviews/{reviewId} {
        allow read: if true;
        
        allow create: if isAuthenticated() &&
          request.resource.data.orderId is string &&
          exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId)) &&
          get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.userId == request.auth.uid &&
          get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.restaurantId == restaurantId;

        allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }
    }

    // Seeded catalog collections
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /nav_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /onboarding_slides/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /campuses/{campusId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /dietaries/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /featured_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /menu_tabs/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /order_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /restaurant_details/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /screen_literals/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tabs/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ui_config/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      // Users can read their own orders; admins can read all orders.
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);

      // Users create pending orders with idempotency protection and rate limiting
      allow create: if isAuthenticated() &&
        isValidOrderCreate() &&
        !isDuplicateOrder() &&
        checkOrderCreateRateLimit();

      // Owners can keep updating a pending order while preserving the core order data.
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.restaurantId == resource.data.restaurantId &&
        request.resource.data.items == resource.data.items &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.status == resource.data.status
      ) || (
        isRestaurantOwner(resource.data.restaurantId) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.restaurantId == resource.data.restaurantId &&
        request.resource.data.items == resource.data.items &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.status in ['accepted', 'preparing', 'ready', 'cancelled']
      ) || (
        isDeliveryStaff() &&
        resource.data.deliveryPersonId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.restaurantId == resource.data.restaurantId &&
        request.resource.data.items == resource.data.items &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.status in ['picked_up', 'delivered']
      );

      // Only admins can delete orders that are completed.
      allow delete: if isAdmin() && resource.data.status in ['delivered', 'cancelled'];
    }

    // Payments Collection
    match /payments/{paymentId} {
      // Users and admins can read payment records.
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);

      // The checkout flow creates the payment record with validation and rate limiting
      allow create: if isAuthenticated() &&
        isValidPaymentCreate() &&
        checkPaymentCreateRateLimit();

      // Users can keep their payment record in sync while keeping the core identity and amount stable.
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.paymentId == resource.data.paymentId &&
        request.resource.data.amount == resource.data.amount &&
        request.resource.data.provider == resource.data.provider &&
        isValidPaymentStatus(request.resource.data.status)
      );
      
      allow delete: if false;
    }

    // Order tracking stream used by the user-facing tracking screen.
    match /order_tracking/{orderId} {
      allow read: if isAdmin() ||
        isOrderOwner(orderId) ||
        (isDeliveryStaff() && exists(/databases/$(database)/documents/orders/$(orderId)) &&
          get(/databases/$(database)/documents/orders/$(orderId)).data.deliveryPersonId == request.auth.uid) ||
        (isAuthenticated() && exists(/databases/$(database)/documents/orders/$(orderId)) &&
          isRestaurantOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.restaurantId));

      allow write: if isAdmin();
    }

    // Delivery Requests Collection
    match /deliveryRequests/{requestId} {
      // Delivery staff can read requests
      allow read: if isDeliveryStaff();
      
      // Admins can manage delivery requests
      allow read, write: if isAdmin();
      
      // System creates requests
      allow create: if isAuthenticated();
      
      // Delivery staff can accept requests
      allow update: if isDeliveryStaff() && 
        request.resource.data.deliveryPersonId == request.auth.uid &&
        request.resource.data.status == 'accepted';
    }

    // Coupons/Promos Collection
    match /coupons/{couponId} {
      // Anyone can read valid coupons
      allow read: if resource.data.active == true;
      
      // Only admins can manage coupons
      allow write: if isAdmin();
    }

    // Support Tickets Collection
    match /supportTickets/{ticketId} {
      // Users can read their own tickets
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Admins can read all tickets
      allow read: if isAdmin();
      
      // Users can create tickets
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Users can update their open tickets
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
        resource.data.status == 'open';
      
      // Admins can update/close tickets
      allow update: if isAdmin();
      
      allow delete: if false;
    }

    // Analytics Collection (for stats, read-only for users)
    match /analytics/{analyticsId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
